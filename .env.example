# Contact form (app/api/contact) — sends through Resend (https://resend.com)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Cogton AI <web@cogton.com>".
# Without it Resend's test sender is used, which only delivers to the account owner.
CONTACT_FROM=
# Inbox that receives the requests (defaults to info@cogton.com)
CONTACT_TO=
